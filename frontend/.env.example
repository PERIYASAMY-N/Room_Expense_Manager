# Backend API URL
# IMPORTANT: On Vercel, this MUST be set as "Config" type (not Secret).
# Vite bakes this value into the bundle at build time.
# Secret type variables are NOT injected during build — use Config type only.
#
# Local development:
VITE_API_URL=http://localhost:5000/api
#
# Production (set this in Vercel → Settings → Environment Variables → Type: Config):
# VITE_API_URL=https://your-render-backend.onrender.com/api
