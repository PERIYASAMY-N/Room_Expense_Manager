# Server
PORT=5000

# Database (MySQL)
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# SSL — set to "true" when connecting to Aiven MySQL (production)
# Leave empty or "false" for local MySQL (no SSL)
DB_SSL=

# SSL CA Certificate — paste the full PEM content of the Aiven CA cert here (for Render)
# Leave empty when running locally (the file at certs/aiven-ca.crt is used instead)
DB_SSL_CA=

# Authentication
JWT_SECRET=

# CORS — set to your Vercel/Render frontend URL in production
FRONTEND_URL=
